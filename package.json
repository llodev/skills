{
  "name": "@llodev/skills-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "llodev agent skills monorepo — pm-tasks-* family",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-frontmatter.mjs && node scripts/validate-schemas.mjs && node scripts/validate-links.mjs && node scripts/validate-locale-parity.mjs && node --test scripts/tarball-snapshot.test.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "skill-judge:check": "node scripts/skill-judge-check.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm run version:sync",
    "changeset:publish": "changeset publish",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "prettier": "^3.3.0"
  }
}
