{
  "name": "@llodev/skills-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "llodev agent skills monorepo — pm-tasks-* family",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/checks/validate-frontmatter.mjs && node scripts/checks/validate-schemas.mjs && node scripts/checks/validate-links.mjs && node scripts/checks/validate-localized-paths.mjs && node scripts/checks/validate-locale-parity.mjs && node --test scripts/checks/tarball-snapshot.test.mjs",
    "contract:check": "node scripts/checks/contract-check.mjs",
    "skill-judge:check": "node scripts/checks/skill-judge-check.mjs",
    "version:sync": "node scripts/checks/sync-version.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm run version:sync",
    "changeset:publish": "changeset publish",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "prettier": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
