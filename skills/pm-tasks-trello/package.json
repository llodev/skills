{
  "name": "@llodev/pm-tasks-trello",
  "version": "1.7.0",
  "description": "Trello adapter for the @llodev/pm-tasks-* family. Use when the user mentions Trello (create card, publish to Trello, post to Trello, --publish, check checklist item, close card, comment on card) or wants to publish a plan as Trello cards. Modes: paste-ready (no MCP needed), MCP publish (via atlassian-trello-mcp), autonomous (sentinel [autonomous] / --auto). Implements 6 CRUD verbs from @llodev/pm-tasks-core/references/contract.md. REQUIRES: @llodev/pm-tasks-core installed (skillpm / Claude Code marketplace cascade auto; Vercel CLI users install manually).",
  "license": "MIT",
  "homepage": "https://github.com/llodev/skills/tree/main/skills/pm-tasks-trello",
  "repository": {
    "type": "git",
    "url": "https://github.com/llodev/skills.git",
    "directory": "skills/pm-tasks-trello"
  },
  "main": "./dist/bin/init.js",
  "types": "./dist/bin/init.d.ts",
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "anti-patterns",
    "references",
    "i18n",
    "schemas",
    "manifest.json",
    "dist"
  ],
  "keywords": [
    "agent-skill",
    "trello",
    "plan-to-tasks",
    "pm-tools",
    "atlassian-trello-mcp"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/init.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": {
      "types": "./dist/bin/init.d.ts",
      "import": "./dist/bin/init.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./i18n/*.json": "./i18n/*.json",
    "./schemas/*.json": "./schemas/*.json",
    "./manifest.json": "./manifest.json"
  },
  "bin": {
    "pm-tasks-trello": "./dist/bin/init.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@llodev/pm-tasks-core": "workspace:^",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
