{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llodev.github.io/skills/schemas/pm-tasks-clickup.json",
  "title": "pm-tasks-clickup config",
  "type": "object",
  "required": ["version", "workspace", "lists"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["1"] },
    "locale": {
      "type": "string",
      "enum": ["en-US", "pt-BR", "es-ES"]
    },
    "workspace": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "lists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "statuses"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "space": { "type": "string" },
          "folder": { "type": "string" },
          "statuses": {
            "type": "object",
            "required": ["open", "done"],
            "additionalProperties": false,
            "properties": {
              "open": { "type": "string" },
              "wip": { "type": "string" },
              "done": { "type": "string" },
              "closed": { "type": "string" }
            }
          }
        }
      }
    },
    "defaultListId": { "type": "string" },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "alias": { "type": "string" }
        }
      }
    },
    "estimation": {
      "type": "object",
      "required": ["strategy", "clickupTarget"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "strategy": {
          "type": "string",
          "enum": [
            "story_points",
            "fibonacci",
            "planning_poker",
            "affinity",
            "t_shirt",
            "ideal_days",
            "ideal_hours",
            "three_point"
          ]
        },
        "clickupTarget": { "type": "string", "enum": ["time", "none"] },
        "hoursPerDay": { "type": "number", "minimum": 1, "maximum": 24 },
        "scale": { "type": "array", "items": { "type": "number" } },
        "sizeMap": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assigneeAlias": { "type": "string" },
        "escalateToAlias": { "type": "string" }
      }
    },
    "autonomous": {
      "type": "object",
      "required": ["enabled", "allow"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "task.create",
              "task.move",
              "checklist.check",
              "task.close",
              "task.due-date.set",
              "task.assignee.add",
              "task.comment.add",
              "task.parent.set",
              "task.estimate.set"
            ]
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lists": { "type": "array", "items": { "type": "string" } }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "writesPerMinute": { "type": "number" },
            "commentsPerMinute": { "type": "number" }
          }
        },
        "auditLog": { "type": "string" }
      }
    },
    "attribution": { "$ref": "https://llodev.com/pm-tasks/attribution.schema.json" }
  }
}
